<Window x:Class="AudioABTester.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AudioABTester"
        Width="980"
        Height="974"
        MinWidth="840"
        MinHeight="743"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Window.InputBindings>
    <KeyBinding Key="Space" Command="{Binding TogglePlayPauseCommand}" />
    <KeyBinding Key="X" Command="{Binding ToggleSourceCommand}" />
    <KeyBinding Key="Left" Command="{Binding SeekBackwardCommand}" />
    <KeyBinding Key="Right" Command="{Binding SeekForwardCommand}" />
  </Window.InputBindings>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <Style x:Key="CardBorderStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource PanelTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource ButtonFillBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="#081019" />
    </Style>

    <Style x:Key="SourceButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" Value="Selected">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Foreground" Value="#081019" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ModeToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" Value="Selected">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Foreground" Value="#081019" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="OutputRadioButtonStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource PanelTextBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E1219" Offset="0" />
        <GradientStop Color="#151B25" Offset="0.55" />
        <GradientStop Color="#10151D" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Border Margin="24" Style="{StaticResource CardBorderStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,18"
                CornerRadius="14"
                Background="#141A23"
                BorderBrush="#242D3C"
                BorderThickness="1"
                Padding="16">
          <StackPanel>
            <TextBlock Text="Audio A/B"
                       Foreground="{DynamicResource PanelTextBrush}"
                       FontSize="24"
                       FontWeight="SemiBold" />

            <TextBlock Margin="0,8,0,0"
                       Text="Choose your test mode first. In blind mode, A/B are randomized and file names stay hidden until reveal."
                       Foreground="{DynamicResource PanelMutedBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal"
                        Margin="0,14,0,0">
              <Button Command="{Binding SelectBlindYesCommand}"
                      Content="Yes, Blind Test"
                      Margin="0,0,10,0">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource ModeToggleButtonStyle}">
                    <Setter Property="Tag" Value="" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsBlindTestSelected}" Value="True">
                        <Setter Property="Tag" Value="Selected" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
                    <Button Command="{Binding SelectBlindNoCommand}"
                      Content="No, Standard Test">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource ModeToggleButtonStyle}">
                    <Setter Property="Tag" Value="" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsStandardTestSelected}" Value="True">
                        <Setter Property="Tag" Value="Selected" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </StackPanel>

            <TextBlock Margin="0,10,0,0"
                       Text="Switching test modes resets loaded files and clears blind randomization."
                       Foreground="{DynamicResource PanelMutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,0,0,12"
              Visibility="{Binding ShowMainWorkflow, Converter={StaticResource BoolToVisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding LoadFileACommand}"
                  Content="{Binding LoadFileAButtonText}" />

          <Border Grid.Column="2"
                  Padding="16,12"
                  CornerRadius="14"
                  Background="#141A23"
                  BorderBrush="#242D3C"
                  BorderThickness="1">
            <TextBlock Text="{Binding FileANameDisplay}"
                       Foreground="{DynamicResource PanelTextBrush}"
                       FontSize="14"
                       TextTrimming="CharacterEllipsis" />
          </Border>
        </Grid>

          <Grid Grid.Row="2"
            Margin="0,0,0,24"
            Visibility="{Binding ShowMainWorkflow, Converter={StaticResource BoolToVisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding LoadFileBCommand}"
              Content="{Binding LoadFileBButtonText}" />

          <Border Grid.Column="2"
                  Padding="16,12"
                  CornerRadius="14"
                  Background="#141A23"
                  BorderBrush="#242D3C"
                  BorderThickness="1">
            <TextBlock Text="{Binding FileBNameDisplay}"
                       Foreground="{DynamicResource PanelTextBrush}"
                       FontSize="14"
                       TextTrimming="CharacterEllipsis" />
          </Border>
        </Grid>

          <Grid Grid.Row="3"
            Margin="0,0,0,24"
            Visibility="{Binding ShowMainWorkflow, Converter={StaticResource BoolToVisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  CornerRadius="18"
                  Background="#141A23"
                  BorderBrush="#242D3C"
                  BorderThickness="1"
                  Padding="18">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Text="Playback"
                         Foreground="{DynamicResource PanelMutedBrush}"
                         FontSize="13"
                         Margin="0,0,0,14" />

              <StackPanel Grid.Row="1"
                          Orientation="Horizontal">
                <Button Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding StartCommand}"
                        Content="Start"
                        Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding PauseCommand}"
                        Content="Pause"
                        Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding StopCommand}"
                        Content="Stop" />
              </StackPanel>

              <TextBlock Grid.Row="2"
                         Text="Audio Output"
                         Foreground="{DynamicResource PanelMutedBrush}"
                         FontSize="13"
                         Margin="0,16,0,8" />

              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#141A23"
                        BorderBrush="#242D3C"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,8"
                        MinHeight="74">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                MaxHeight="120">
                    <ListBox Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding OutputDevices}"
                             SelectedValuePath="Id"
                             SelectedValue="{Binding SelectedOutputDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Margin" Value="0" />
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="BorderThickness" Value="0" />
                          <Setter Property="Focusable" Value="False" />
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <RadioButton Style="{StaticResource OutputRadioButtonStyle}"
                                       Content="{Binding Name}"
                                       IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </ScrollViewer>
                </Border>

                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RefreshOutputDevicesCommand}"
                        Content="Refresh" />
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Column="2"
                  CornerRadius="18"
                  Background="#141A23"
                  BorderBrush="#242D3C"
                  BorderThickness="1"
                  Padding="18">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Text="{Binding ComparisonPanelTitle}"
                         Foreground="{DynamicResource PanelMutedBrush}"
                         FontSize="13"
                         Margin="0,0,0,14" />

              <StackPanel Grid.Row="1"
                          Orientation="Horizontal">
                <Button Command="{Binding ListenACommand}"
                        Content="Listen A"
                        Margin="0,0,10,0">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SourceButtonStyle}">
                      <Setter Property="Tag" Value="" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListeningToA}" Value="True">
                          <Setter Property="Tag" Value="Selected" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>

                <Button Command="{Binding ListenBCommand}"
                        Content="Listen B">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SourceButtonStyle}">
                      <Setter Property="Tag" Value="" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListeningToB}" Value="True">
                          <Setter Property="Tag" Value="Selected" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>

                <Grid Grid.Row="2"
                  Margin="0,12,0,0">
                  <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                <Button Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding RevealBlindMappingCommand}"
                        Content="Reveal A/B Mapping"
                        Visibility="{Binding ShowRevealButton, Converter={StaticResource BoolToVisibilityConverter}}" />

                  <Button Grid.Row="1"
                  Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ResetBlindRoundCommand}"
                        Content="Reset Blind Round"
                  Margin="0,10,0,0"
                        Visibility="{Binding IsBlindTestSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Grid>
          </Border>
        </Grid>

        <Border Grid.Row="4"
                CornerRadius="18"
                Background="#111721"
                BorderBrush="#242D3C"
                BorderThickness="1"
                Padding="20"
                Visibility="{Binding ShowMainWorkflow, Converter={StaticResource BoolToVisibilityConverter}}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Text="{Binding CurrentSourceText}"
                         Foreground="{DynamicResource PanelTextBrush}"
                         FontSize="22"
                         FontWeight="SemiBold" />

              <TextBlock Grid.Column="1"
                         Text="{Binding PlaybackTime}"
                         Foreground="{DynamicResource PanelTextBrush}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Right" />
            </Grid>

            <Slider Grid.Row="1"
                    Margin="0,18,0,14"
                    Minimum="0"
                    Maximum="{Binding DurationSeconds}"
                    Value="{Binding PositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsMoveToPointEnabled="True"
                    TickPlacement="None"
                    SmallChange="1"
                    LargeChange="5" />

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Text="{Binding ToggleHintText}"
                         Foreground="{DynamicResource PanelMutedBrush}"
                         FontSize="13" />

              <TextBlock Grid.Column="1"
                         Text="Left/Right: -/+ 5 sec"
                         Foreground="{DynamicResource PanelMutedBrush}"
                         FontSize="13" />
            </Grid>

            <Border Grid.Row="3"
                    Margin="0,22,0,0"
                    CornerRadius="16"
                    Background="#151D28"
                    BorderBrush="#242D3C"
                    BorderThickness="1"
                    Padding="16">
              <StackPanel>
                <TextBlock Text="{Binding BlindStatusText}"
                           Foreground="{DynamicResource PanelMutedBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding OutputDeviceStatus}"
                           Foreground="{DynamicResource PanelMutedBrush}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>