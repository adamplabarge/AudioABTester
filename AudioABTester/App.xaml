<Application x:Class="AudioABTester.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#10141B" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#CC171C25" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2C3444" />
    <SolidColorBrush x:Key="PanelMutedBrush" Color="#8692A6" />
    <SolidColorBrush x:Key="PanelTextBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#1F7AA6" />
    <SolidColorBrush x:Key="ButtonFillBrush" Color="#212836" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#293244" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#1B2230" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#364055" />
  </Application.Resources>
</Application>